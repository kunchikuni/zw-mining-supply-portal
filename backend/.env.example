# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://user:password@localhost:5432/zw_supplier_portal"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3000

# Phase 2 — file storage (S3-compatible)
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Email (new-RFQ alerts), over SMTP. Without SMTP_HOST, emails wait in the
# EmailOutbox table and nothing is sent. For local development, run Mailpit
# (a catch-all inbox at http://localhost:8025):
#   docker run -d --name zwsp-mailpit -p 127.0.0.1:1025:1025 -p 127.0.0.1:8025:8025 axllent/mailpit
# and set SMTP_HOST=127.0.0.1, SMTP_PORT=1025.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="ZW Supplier Portal <no-reply@example.com>"
# The frontend's address, for links in emails.
APP_URL="http://localhost:3001"

# Phase 2 — other notification channels
WHATSAPP_BUSINESS_API_TOKEN=""
SMS_GATEWAY_API_KEY=""

# Phase 3 — payments
PAYNOW_INTEGRATION_ID=""
PAYNOW_INTEGRATION_KEY=""
