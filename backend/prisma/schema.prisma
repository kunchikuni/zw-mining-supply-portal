// ZW Supplier Portal — core data model
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyType {
  MINE
  SUPPLIER
  // The portal operator's own company, which VERIFIER / PLATFORM_ADMIN users
  // belong to (every user needs a company). Never offered at signup, never
  // listed in the directory, and can't bid (it has no categories and is
  // never verified). Created only by `npm run create:staff`.
  PLATFORM
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum UserRole {
  PLATFORM_ADMIN
  COMPANY_ADMIN
  COMPANY_MEMBER
  VERIFIER
}

enum DocumentType {
  COMPANY_REGISTRATION   // CR6 / CR14
  TAX_CLEARANCE          // ZIMRA ITF263
  NSSA_COMPLIANCE
  PRAZ_REGISTRATION
  SAFETY_CERTIFICATE
  QUALITY_CERTIFICATE
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum RfqStatus {
  OPEN
  CLOSED
  AWARDED
  CANCELLED
}

enum BidStatus {
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Company {
  id                 String              @id @default(uuid())
  name               String
  type               CompanyType
  province            String?
  town                String?
  registrationNumber  String?             @unique
  verificationStatus  VerificationStatus  @default(UNVERIFIED)
  isLocallyOwned      Boolean             @default(false)
  yearsOperating      Int?
  description         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  users               User[]
  invites             Invite[]
  documents           Document[]
  categories          CompanyCategory[]
  postedRfqs          Rfq[]               @relation("MineRfqs")
  bids                Bid[]
  ratingsReceived     Rating[]            @relation("RatedCompany")
  ratingsGiven        Rating[]            @relation("RatingAuthor")

  @@index([type])
  @@index([verificationStatus])
}

model User {
  id           String    @id @default(uuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  email        String    @unique
  passwordHash String
  fullName     String
  role         UserRole  @default(COMPANY_MEMBER)
  phone        String?
  createdAt    DateTime  @default(now())

  @@index([companyId])
}

// One-time code that lets a person join an existing company. Company creation
// mints the first one (role COMPANY_ADMIN); that admin invites everyone after.
// Only the SHA-256 of the code is stored, so a DB read can't redeem one.
model Invite {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  codeHash  String    @unique
  role      UserRole  @default(COMPANY_MEMBER)
  email     String?   // when set, only this address may redeem the code
  createdBy String?   // inviting user's id; null for the bootstrap invite
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([companyId])
}

model Category {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?

  companies   CompanyCategory[]
  rfqs        Rfq[]
}

model CompanyCategory {
  companyId  String
  categoryId String
  company    Company  @relation(fields: [companyId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([companyId, categoryId])
}

model Document {
  id         String         @id @default(uuid())
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id])
  docType    DocumentType
  fileUrl    String
  status     DocumentStatus @default(PENDING)
  expiresAt  DateTime?
  reviewedBy String?
  reviewNote String?
  uploadedAt DateTime       @default(now())

  @@index([companyId])
  @@index([status])
}

model Rfq {
  id             String    @id @default(uuid())
  mineCompanyId  String
  mine           Company   @relation("MineRfqs", fields: [mineCompanyId], references: [id])
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  title          String
  description    String
  quantity       String?
  province        String?
  deadline        DateTime
  status          RfqStatus @default(OPEN)
  createdAt       DateTime  @default(now())

  bids            Bid[]
  ratings         Rating[]

  @@index([mineCompanyId])
  @@index([status])
  @@index([categoryId])
}

model Bid {
  id                String    @id @default(uuid())
  rfqId             String
  rfq               Rfq       @relation(fields: [rfqId], references: [id])
  supplierCompanyId String
  supplier          Company   @relation(fields: [supplierCompanyId], references: [id])
  amount            Decimal   @db.Decimal(14, 2)
  currency          String    @default("USD")
  leadTimeDays      Int?
  notes             String?
  status            BidStatus @default(SUBMITTED)
  submittedAt       DateTime  @default(now())

  @@index([rfqId])
  @@index([supplierCompanyId])
}

model Rating {
  id             String   @id @default(uuid())
  rfqId          String
  rfq            Rfq      @relation(fields: [rfqId], references: [id])
  ratedCompanyId String
  ratedCompany   Company  @relation("RatedCompany", fields: [ratedCompanyId], references: [id])
  authorCompanyId String
  authorCompany   Company @relation("RatingAuthor", fields: [authorCompanyId], references: [id])
  score          Int      // 1-5, enforced by CreateRatingDto
  comment        String?
  createdAt      DateTime @default(now())

  // A mine rates each supplier it awarded once per RFQ. Enforced here rather
  // than with a read-then-write check, so two concurrent requests can't both
  // get through.
  @@unique([rfqId, authorCompanyId, ratedCompanyId])
  @@index([ratedCompanyId])
}
